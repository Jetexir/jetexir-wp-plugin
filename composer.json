{
  "name": "jetexir/jetexir-wp-plugin",
  "description": "Jetexir",
  "type": "project",
  "scripts": {
    "jetexir-autoload": "composer dump-autoload"
  },
  "autoload": {
    "psr-4": {
      "Jetexir\\": [
        "inc/"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true
  },
  "authors": [
    {
      "name": "Parsa Kafi",
      "email": "parsadeng@gmail.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "symfony/polyfill-php80": "^1.37.0",
    "symfony/polyfill-php81": "^1.38.1",
    "enshrined/svg-sanitize": "^0.22.0"
  }
}
