{
  "name": "parsa-kafi/assistant-for-woocommerce",
  "description": "Assistant for WooCommerce",
  "type": "project",
  "scripts": {
    "assistant-for-woocommerce-autoload": "composer dump-autoload"
  },
  "autoload": {
    "psr-4": {
      "AssistantForWooCommerce\\": [
        "inc/"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true
  },
  "authors": [
    {
      "name": "Parsa Kafi",
      "email": "parsadeng@gmail.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "enshrined/svg-sanitize": "^0.22.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  }
}
